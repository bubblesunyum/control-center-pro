# Build artifacts
build/
dist/
.build/
# `swift package edit` parks its symlinks here.
Packages/
*.dmg

# Signing material: never commit private keys or notary credentials
*.p12
*.pem
*.cer
*.p8
*.key
*.mobileprovision
*.keychain-db

# OAuth client credentials for the mail widget. AppBundle/Info.plist is
# tracked, so the credential lives beside it and is merged into the bundle
# at assembly time instead. See AppBundle/Secrets.example.plist.
AppBundle/Secrets.plist

# Local-only working notes
E2E/

# macOS noise
.DS_Store

# Xcode / SwiftPM user state — note *.xcodeproj is deliberately NOT ignored:
# upstream ignores it, we commit ours. Only the per-user state inside it goes.
xcuserdata/
.swiftpm/
.cursor/
.gemini/

# ── CCP additions (merge-conflict hotspot; keep our entries in this block) ──
# Upstream ignores AGENTS.md and CLAUDE.md as local-only working notes. We
# track both — they are the harness's always-loaded instructions — so those two
# lines are deliberately absent above. Re-check after every upstream merge.

# Graphify local graph (on-demand skill .claude/skills/graphify) — never committed.
graphify-out/
Sources/**/graphify-out/

# Python bytecode from the harness scripts
__pycache__/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# The live dashboard port, rewritten on every bind — machine-local.
.claude/launch.json

# The dashboard snapshot, regenerated on every poll — machine-local.
dashboard/state.json

# The Tiptap spike's npm install (Spikes/tiptap-editor).
node_modules/

# Per-role models, naming what this machine happens to have — machine-local.
harness/models.json

# Agent scratch — created here, removed when done, never committed.
.tmp/

# Codex agents generated from the shared prompts — scripts/h link regenerates them.
.codex/agents/
.claude/skills/beads
.claude/skills/delegate
.claude/skills/handoff
.claude/skills/output-style
.claude/skills/workflow
.claude/agents/librarian.md
.claude/agents/reviewer-correctness.md
.claude/agents/reviewer-design.md
.claude/agents/reviewer-taste.md
.opencode/agent/librarian.md
.opencode/agent/reviewer-correctness.md
.opencode/agent/reviewer-design.md
.opencode/agent/reviewer-taste.md
harness/stacks/swift.md
.harness-contract.md
