# Build artifacts
build/
dist/
.build/
*.dmg

# Signing material: never commit private keys or notary credentials
*.p12
*.pem
*.cer
*.p8
*.key
*.mobileprovision
*.keychain-db

# Local-only working notes
E2E/

# macOS noise
.DS_Store

# Xcode / SwiftPM user state — note *.xcodeproj is deliberately NOT ignored:
# upstream ignores it, we commit ours. Only the per-user state inside it goes.
xcuserdata/
.swiftpm/
.cursor/
.gemini/

# ── CCP additions (merge-conflict hotspot; keep our entries in this block) ──
# Upstream ignores AGENTS.md and CLAUDE.md as local-only working notes. We
# track both — they are the harness's always-loaded instructions — so those two
# lines are deliberately absent above. Re-check after every upstream merge.

# Python bytecode from the harness scripts
__pycache__/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
