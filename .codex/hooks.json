{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/brief.sh\" --hook",
            "timeout": 60,
            "statusMessage": "Loading the harness brief"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/dashboard.py\" up",
            "timeout": 60,
            "statusMessage": "Starting the harness dashboard"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/dashboard.py\" down",
            "timeout": 60,
            "statusMessage": "Stopping the harness dashboard"
          }
        ]
      }
    ]
  }
}
